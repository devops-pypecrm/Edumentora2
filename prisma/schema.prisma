generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  status    String   @default("SHOW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

model HeroSlide {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  imageUrl  String
  altText   String
  status    String   @default("SHOW")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_slides")
}

model Reel {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  category  String
  videoUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reels")
}

model Faq {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model AdminConfig {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  passwordHash String
  updatedAt    DateTime @updatedAt

  @@map("admin_config")
}

model CrmConfig {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  apiKey      String
  endpointUrl String
  updatedAt   DateTime @updatedAt

  @@map("crm_config")
}

model EnquiryList {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String?
  email     String
  phone     String
  company   String?
  message   String
  source    String
  createdAt DateTime @default(now())

  @@map("enquiry_list")
}

model EligibilityRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String?
  email     String
  phone     String
  company   String?
  message   String
  source    String
  createdAt DateTime @default(now())

  @@map("eligibility_request")
}

model Gallery {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  section   String
  images    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gallery")
}

model University {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  location     String
  description  String
  mainImage    String?
  logo         String?
  certificates String[]

  visionHeading        String?
  visionPara           String?
  facilitiesHeading    String?
  facilitiesPara       String?
  featuresHeading      String?
  featuresPara         String?
  whyChooseHeading     String?
  whyChoosePara        String?
  btechProgramsHeading String?
  btechProgramsPara    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  programs  UniversityProgram[]
  brochure  Brochure?

  @@map("universities")
}

model Brochure {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fileName  String
  fileUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  universityId String     @unique @db.ObjectId
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@map("brochures")
}

model UniversityProgram {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  programName          String?
  courseDescription    String?
  specializations      String[]
  courseDuration       String?
  eligibilityCriteria  String[]
  careerOpportunities  String[]
  feeStructure         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  universityId String     @db.ObjectId
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@map("university_programs")
}

model Contact {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  department  String?
  description String?
  lanphone    String?
  mob         String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contacts")
}

type BlogSection {
  subHeading String
  subPara    String
}

model Blog {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  date       DateTime
  category   String
  sectionDis String
  author     String?
  mainImage  String?
  mainDis    BlogSection[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  comments   Comment[]

  @@map("blogs")
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  website   String?
  content   String
  createdAt DateTime @default(now())
  
  blogId    String   @db.ObjectId
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Program {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  topic       String   @default("General")
  heroImage   String?
  heading     String
  subHeading  String?
  paragraph   String
  blocks      Json[]   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("programs")
}

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  username   String
  postedDate DateTime
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("reviews")
}

model NavigationItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  href      String
  visibility Boolean  @default(true)
  kind      String   @default("nav")
  parentId  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("navigation_items")
}
